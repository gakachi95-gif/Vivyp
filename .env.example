# Copy this file to .env for local testing.
# On Render, you do NOT upload this file — you paste these same values into
# Render's dashboard under your service's "Environment" tab instead.
# Never commit a real .env file to GitHub.

# --- Server ---
PORT=3000

# Comma-separated list of origins allowed to call this API.
# This should be your GitHub Pages URL (and custom domain, once you have one).
# Example: https://yourusername.github.io,https://vivy.yourdomain.com
ALLOWED_ORIGINS=https://yourusername.github.io

# --- Flutterwave ---
# Your SECRET key from the Flutterwave dashboard (Settings -> API Keys).
# This must NEVER appear in the Vivy frontend/GitHub Pages code — only here.
FLW_SECRET_KEY=FLWSECK_TEST-replace-with-your-real-secret-key-X

# A random string you choose yourself, then paste into Flutterwave's dashboard
# under Settings -> Webhooks -> "Secret hash". Used to confirm a webhook call
# really came from Flutterwave. Generate any long random string for this.
FLW_WEBHOOK_HASH=replace-with-a-long-random-string-you-invent

# --- Email delivery (using Resend: https://resend.com — has a free tier) ---
# API key from your Resend account.
RESEND_API_KEY=re_replace_with_your_real_resend_api_key

# The "from" address customers will see. Must be a domain you've verified
# with Resend (or use their onboarding@resend.dev sandbox address for testing).
RESEND_FROM_EMAIL=Vivy <orders@yourdomain.com>

# --- Product data ---
# The LIVE products.json on your deployed Vivy GitHub Pages site. The backend
# fetches this at request time so you only ever have to edit product info in
# ONE place (data/products.json in the Vivy repo) — no backend redeploy needed
# when you add a product or change a price.
# Example: https://yourusername.github.io/your-repo/data/products.json
PRODUCTS_JSON_URL=https://yourusername.github.io/your-repo/data/products.json
