hereq{
  "name": "vivy-backend",
  "version": "1.0.0",
  "description": "Small backend for Vivy: verifies Flutterwave payments server-to-server and delivers purchased digital products by email. Deployed separately from the static Vivy site (e.g. on Render).",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pg": "^8.16.3"
  }
}
